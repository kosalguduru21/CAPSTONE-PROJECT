    {
      "name": "Work Orders",
      "item": [
        {
          "name": "List Work Orders",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/work-orders", "host": ["{{baseUrl}}"], "path": ["api", "work-orders"] }
          }
        },
        {
          "name": "Create Work Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Kitchen sink drain dripping slowly\",\n  \"description\": \"Intermittent leak under the double sink bowl. Water collects in pan.\",\n  \"category\": \"plumbing\",\n  \"priority\": \"Normal\",\n  \"preferredAccessWindows\": [{\"date\": \"2026-10-28\", \"timeSlot\": \"Morning (8am-12pm)\"}]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/work-orders", "host": ["{{baseUrl}}"], "path": ["api", "work-orders"] }
          }
        },
        {
          "name": "Get Work Order Details",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/work-orders/{{workOrderId}}", "host": ["{{baseUrl}}"], "path": ["api", "work-orders", "{{workOrderId}}"] }
          }
        },
        {
          "name": "Assign Vendor (Manager)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vendorId\": \"{{vendorId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/work-orders/{{workOrderId}}/assignment", "host": ["{{baseUrl}}"], "path": ["api", "work-orders", "{{workOrderId}}", "assignment"] }
          }
        },
        {
          "name": "Completion Review / Reopen",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"satisfied\": false,\n  \"reopenReason\": \"Pipe still dripping after repair.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/work-orders/{{workOrderId}}/completion-review", "host": ["{{baseUrl}}"], "path": ["api", "work-orders", "{{workOrderId}}", "completion-review"] }
          }
        }
      ]
    },
    {
      "name": "AI Subsystem",
      "item": [
        {
          "name": "Grounded Maintenance Chat (RAG)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Who is responsible for fixing a leaking pipe under the sink?\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/maintenance-chat", "host": ["{{baseUrl}}"], "path": ["api", "maintenance-chat"] }
          }
        },
        {
          "name": "Related-Case Discovery (Vector Search)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/work-orders/{{workOrderId}}/related-cases", "host": ["{{baseUrl}}"], "path": ["api", "work-orders", "{{workOrderId}}", "related-cases"] }
          }
        },
        {
          "name": "Run Scheduling Agent",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"timeframe\": \"next_week\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/scheduling-agent", "host": ["{{baseUrl}}"], "path": ["api", "scheduling-agent"] }
          }
        },
        {
          "name": "Confirm Proposed Schedule (Manager)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"proposalId\": \"{{proposalId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/scheduling-agent/confirm", "host": ["{{baseUrl}}"], "path": ["api", "scheduling-agent", "confirm"] }
          }
        }
      ]
    }
  ],
