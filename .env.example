# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/apartment_maintenance

# Session & Security
SESSION_SECRET=development_session_secret_change_in_production_min_32_chars
COOKIE_SECRET=development_cookie_secret_change_in_production
SESSION_EXPIRY_DAYS=7

# Local Language Model (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_DIMENSION=2560

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=10485760
