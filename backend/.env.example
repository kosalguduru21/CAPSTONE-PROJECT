# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database Connection (MongoDB Atlas or Local MongoDB)
DB_URL=mongodb://127.0.0.1:27017/apartment_maintenance

# Security Secrets
SESSION_SECRET=your-random-session-secret-change-in-production
CSRF_SECRET=your-random-csrf-secret-change-in-production

# Ollama Local AI Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_DIMENSIONS=2560

# File Uploads Directory
UPLOAD_DIR=./uploads
